# ─── Supabase (NEW separate Supabase project for Bangladesh) ─────────────────
# Create a brand-new project at https://supabase.com, run supabase/schema.sql,
# Create a public Storage bucket named "payment-screenshots"
# then paste the keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_BD_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Gemini AI (For Automated bKash Screenshot Verification) ─────────────────
# Get free API key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# ─── Google Analytics 4 & Google Ads ──────────────────────────────────────────
# Create a NEW GA4 property for Bangladesh at analytics.google.com
NEXT_PUBLIC_GA_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GA_LEAD_LABEL=XXXXXXXXXXXX
NEXT_PUBLIC_GA_PURCHASE_LABEL=XXXXXXXXXXXX

NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# API Secret for Measurement Protocol (server-side purchase events)
GA4_API_SECRET=YOUR_GA4_API_SECRET

# ─── Meta / Facebook ─────────────────────────────────────────────────────────
# Create a NEW Meta Pixel for Bangladesh at events.facebook.com
NEXT_PUBLIC_FB_PIXEL_ID=YOUR_BD_FB_PIXEL_ID
META_ACCESS_TOKEN=YOUR_BD_META_CAPI_TOKEN

# ─── Resend (Email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=bootcamp@yourdomain.com

# ─── bKash Payment ───────────────────────────────────────────────────────────
# REPLACE with your actual bKash number (the number students will send money to)
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
# REPLACE with the account name registered to your bKash
NEXT_PUBLIC_BKASH_ACCOUNT_NAME=Your Name

# ─── Course Config ────────────────────────────────────────────────────────────
# Price in BDT (Bangladeshi Taka) — e.g. 3500 = ৳3,500
COURSE_PRICE=3500
NEXT_PUBLIC_COURSE_PRICE=3500
COURSE_NAME=AI Video Bootcamp Bangladesh
COURSE_ACCESS_LINK=https://your-lms-link.com

# ─── WhatsApp Support ────────────────────────────────────────────────────────
# BD WhatsApp number WITHOUT + sign, with country code 880
# e.g. if your number is 01712345678 → write 8801712345678
NEXT_PUBLIC_WHATSAPP_SUPPORT=880XXXXXXXXXX

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_this_to_something_very_strong_123!

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com.bd
